<%- include('../partials/header', { titulo }) %>
<section class="form-page wide"><p class="eyebrow">RESERVAS</p><h1>Reservar un equipo</h1><p>Selecciona fecha y turno. Las opciones se actualizan según la disponibilidad.</p><% if (vm.errores?.length) { %><div class="error-list"><ul><% vm.errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %><form class="form-card" method="get" action="/reservas/nueva"><div class="form-row"><label>Fecha<input type="date" name="fecha" required min="<%= new Date().toISOString().slice(0,10) %>" value="<%= vm.fecha %>"></label><label>Turno<select name="turno" required><option value="manana" <%= vm.turno === 'manana' ? 'selected' : '' %>>Mañana</option><option value="tarde" <%= vm.turno === 'tarde' ? 'selected' : '' %>>Tarde</option></select></label></div><button class="button" type="submit">Consultar disponibilidad</button></form><form class="form-card" method="post" action="/reservas"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fecha" value="<%= vm.fecha %>"><input type="hidden" name="turno" value="<%= vm.turno %>"><label>Equipo disponible<select name="equipoId" required><option value="">Selecciona un equipo</option><% vm.equipos.forEach(e => { %><option value="<%= e.id %>" <%= String(vm.valores?.equipoId ?? '') === String(e.id) ? 'selected' : '' %>><%= e.codigo %> — <%= e.nombre %></option><% }) %></select></label><p class="muted">Fecha: <strong><%= vm.fecha %></strong> · Turno: <strong><%= vm.turno === 'manana' ? 'Mañana' : 'Tarde' %></strong></p><button class="button full" type="submit" <%= vm.equipos.length === 0 ? 'disabled' : '' %>>Confirmar reserva</button><% if (vm.equipos.length === 0) { %><p class="empty-note">No hay equipos disponibles para esa fecha y turno. Prueba otra combinación.</p><% } %></form></section>
<%- include('../partials/footer') %>
