<%- include('../partials/header', { titulo }) %>
<section class="form-page"><p class="eyebrow">NUEVA CUENTA</p><h1>Crear cuenta</h1><p>El registro público crea cuentas con rol de usuario.</p><% if (errores.length) { %><div class="error-list"><ul><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %><form class="form-card" method="post" action="/registro"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nombre<input name="nombre" required minlength="2" maxlength="80" value="<%= valores.nombre ?? '' %>"></label><label>Correo electrónico<input type="email" name="email" required maxlength="160" autocomplete="email" value="<%= valores.email ?? '' %>"></label><label>Contraseña<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"><small>Al menos 8 caracteres.</small></label><button class="button full" type="submit">Crear cuenta</button><p class="form-bottom">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p></form></section>
<%- include('../partials/footer') %>
