<%- include('../partials/header', { titulo }) %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Todas las reservas</h1><p>Consulta y cancela reservas activas del centro.</p></div></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Usuario</th><th>Equipo</th><th>Fecha</th><th>Turno</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% reservas.forEach(r => { %><tr><td>#<%= r.id %></td><td><%= r.usuario?.nombre ?? 'Usuario no disponible' %><br><small><%= r.usuario?.email ?? '' %></small></td><td><%= r.equipo?.codigo ?? 'Equipo no disponible' %><br><small><%= r.equipo?.nombre ?? '' %></small></td><td><%= r.fecha %></td><td><%= r.turno === 'manana' ? 'Mañana' : 'Tarde' %></td><td><span class="status status-<%= r.estado === 'activa' ? 'ok' : 'off' %>"><%= r.estado %></span></td><td><% if (r.estado === 'activa') { %><form method="post" action="/admin/reservas/<%= r.id %>/cancelar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger small" type="submit">Cancelar</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/footer') %>
