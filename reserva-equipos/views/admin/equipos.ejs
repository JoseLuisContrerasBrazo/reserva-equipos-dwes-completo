<%- include('../partials/header', { titulo }) %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Gestionar equipos</h1><p>Añade equipos y actualiza su estado.</p></div></div><% if (errores.length) { %><div class="error-list"><ul><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %><section class="admin-panel"><h2>Añadir equipo</h2><form class="form-inline-grid" method="post" action="/admin/equipos"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Código<input name="codigo" required minlength="3" maxlength="30" placeholder="PORT-002"></label><label>Nombre<input name="nombre" required minlength="3" maxlength="100" placeholder="Portátil aula 2"></label><label>Tipo<select name="tipo"><option value="portatil">Portátil</option><option value="sobremesa">Sobremesa</option></select></label><button class="button" type="submit">Añadir equipo</button></form></section><div class="table-wrap"><table><thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Estado</th><th>Actualizar</th></tr></thead><tbody><% equipos.forEach(e => { %><tr><td><strong><%= e.codigo %></strong></td><td><%= e.nombre %></td><td><%= e.tipo %></td><td><%= e.estado === 'operativo' ? 'Operativo' : 'Fuera de servicio' %></td><td><form class="inline-form" method="post" action="/admin/equipos/<%= e.id %>/estado"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="estado"><option value="operativo" <%= e.estado === 'operativo' ? 'selected' : '' %>>Operativo</option><option value="fuera_de_servicio" <%= e.estado === 'fuera_de_servicio' ? 'selected' : '' %>>Fuera de servicio</option></select><button class="button small" type="submit">Guardar</button></form></td></tr><% }) %></tbody></table></div>
<%- include('../partials/footer') %>
