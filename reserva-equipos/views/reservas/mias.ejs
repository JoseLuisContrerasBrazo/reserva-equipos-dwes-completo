<%- include('../partials/header', { titulo }) %>
<div class="page-heading"><div><p class="eyebrow">TU ACTIVIDAD</p><h1>Mis reservas</h1><p>Consulta el historial y cancela las reservas activas que todavía no han pasado.</p></div><a class="button" href="/reservas/nueva">Nueva reserva</a></div>
<div class="table-wrap"><table><thead><tr><th>Equipo</th><th>Fecha</th><th>Turno</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% reservas.forEach(r => { %><tr><td><strong><%= r.equipo?.codigo ?? 'Equipo no disponible' %></strong><br><small><%= r.equipo?.nombre ?? '' %></small></td><td><%= r.fecha %></td><td><%= r.turno === 'manana' ? 'Mañana' : 'Tarde' %></td><td><span class="status status-<%= r.estado === 'activa' ? 'ok' : 'off' %>"><%= r.estado === 'activa' ? 'Activa' : 'Cancelada' %></span></td><td><% if (r.estado === 'activa' && new Date(`${r.fecha}T00:00:00`) >= new Date(new Date().setHours(0,0,0,0))) { %><form method="post" action="/reservas/<%= r.id %>/cancelar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger small" type="submit">Cancelar</button></form><% } else { %><span class="muted">—</span><% } %></td></tr><% }) %></tbody></table></div><% if (!reservas.length) { %><div class="empty-state"><h2>Aún no tienes reservas</h2><a href="/reservas/nueva">Crear una reserva</a></div><% } %>
<%- include('../partials/footer') %>
