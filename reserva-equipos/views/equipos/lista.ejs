<%- include('../partials/header', { titulo }) %>
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO</p><h1>Equipos informáticos</h1><p>Consulta los equipos y su estado actual.</p></div></div>
<form class="filter-panel" method="get" action="/equipos"><label>Tipo<select name="tipo"><option value="">Todos</option><option value="portatil" <%= filtros.tipo === 'portatil' ? 'selected' : '' %>>Portátil</option><option value="sobremesa" <%= filtros.tipo === 'sobremesa' ? 'selected' : '' %>>Sobremesa</option></select></label><label class="check-label"><input type="checkbox" name="operativos" value="true" <%= filtros.operativos ? 'checked' : '' %>> Solo operativos</label><button class="button" type="submit">Filtrar</button><a class="button button-secondary" href="/equipos">Limpiar</a></form>
<div class="equipment-grid"><% equipos.forEach((equipo) => { %><article class="equipment-card"><div class="card-top"><span class="device-icon small">▣</span><span class="status status-<%= equipo.estado === 'operativo' ? 'ok' : 'off' %>"><%= equipo.estado === 'operativo' ? 'Operativo' : 'Fuera de servicio' %></span></div><p class="eyebrow"><%= equipo.codigo %></p><h2><%= equipo.nombre %></h2><p><%= equipo.tipo === 'portatil' ? 'Portátil' : 'Sobremesa' %></p><a class="text-link" href="/equipos/<%= equipo.id %>">Ver ficha →</a></article><% }) %></div>
<% if (equipos.length === 0) { %><div class="empty-state"><h2>No hay equipos que coincidan</h2><p>Prueba a cambiar los filtros.</p></div><% } %>
<%- include('../partials/footer') %>
